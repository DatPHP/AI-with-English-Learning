{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Stores user information and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "flashcards": {
      "title": "Flashcard",
      "description": "Vocabulary items for learning.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "word": { "type": "string" },
        "phonetic": { "type": "string" },
        "meaning": { "type": "string" },
        "wordFamily": { "type": "string" },
        "example": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "word", "meaning"]
    },
    "grammarBlogs": {
      "title": "Grammar Blog",
      "description": "English grammar topics formatted as blog posts.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content"]
    },
    "speakingChallenges": {
      "title": "Speaking Challenge",
      "description": "Progress tracking for the 30-day speaking challenge.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "targetEndDate": { "type": "string", "format": "date-time" },
        "completedDays": { "type": "array", "items": { "type": "number" } },
        "lastCompletedDay": { "type": "number" },
        "attempts": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["userId", "startDate", "targetEndDate"]
    },
    "workshopProgress": {
      "title": "Workshop Progress",
      "description": "Progress tracking for pronunciation workshop sessions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "completedSessionIds": { "type": "array", "items": { "type": "string" } },
        "lastSessionId": { "type": "string" }
      },
      "required": ["userId", "completedSessionIds"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile documents."
    },
    "/flashcards/{cardId}": {
      "schema": "flashcards",
      "description": "Flashcards for vocabulary learning."
    },
    "/grammarBlogs/{blogId}": {
      "schema": "grammarBlogs",
      "description": "Grammar blog posts."
    },
    "/speakingChallenges/{userId}": {
      "schema": "speakingChallenges",
      "description": "30-day speaking challenge progress."
    },
    "/workshopProgress/{userId}": {
      "schema": "workshopProgress",
      "description": "Pronunciation workshop progress."
    }
  }
}
